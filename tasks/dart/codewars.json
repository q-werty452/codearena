      "type": "code",
      "topic": "Функции",
      "difficulty": "easy",
      "timeLimitSec": 420,
      "language": "dart",
      "prompt": "Верни площадь прямоугольника со сторонами a и b.",
      "starter": "int area(int a, int b) {\n  return 0;\n}",
      "tests": [
        {
          "call": "area(3, 4)",
          "expected": "12"
        },
        {
          "call": "area(5, 5)",
          "expected": "25"
        },
        {
          "call": "area(0, 7)",
          "expected": "0"
        }
      ],
      "rules": [],
      "solution": "int area(int a, int b) {\n  return a * b;\n}",
      "explanation": "Площадь — произведение сторон."
    },
    {
