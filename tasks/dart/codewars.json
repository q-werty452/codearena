    {
      "type": "code",
      "topic": "Циклы",
      "difficulty": "easy",
      "timeLimitSec": 420,
      "language": "dart",
      "prompt": "Верни факториал n (n ≥ 0): 5! = 120, 0! = 1.",
      "starter": "int factorial(int n) {\n  return 0;\n}",
      "tests": [
        {
          "call": "factorial(5)",
          "expected": "120"
        },
        {
          "call": "factorial(0)",
          "expected": "1"
        },
        {
          "call": "factorial(1)",
          "expected": "1"
        }
      ],
      "rules": [],
      "solution": "int factorial(int n) {\n  var r = 1;\n  for (var i = 2; i <= n; i++) {\n    r *= i;\n  }\n  return r;\n}",
      "explanation": "Перемножаем числа от 2 до n."
    },
