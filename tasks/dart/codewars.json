    {
      "type": "code",
      "topic": "Списки",
      "difficulty": "easy",
      "timeLimitSec": 420,
      "language": "dart",
      "prompt": "Верни сумму чисел списка (без reduce и fold).",
      "starter": "int total(List<int> nums) {\n  return 0;\n}",
      "tests": [
        {
          "call": "total([1, 2, 3])",
          "expected": "6"
        },
        {
          "call": "total([])",
          "expected": "0"
        },
        {
          "call": "total([-5, 5])",
          "expected": "0"
        }
      ],
      "rules": [],
      "solution": "int total(List<int> nums) {\n  var s = 0;\n  for (var n in nums) {\n    s += n;\n  }\n  return s;\n}",
      "explanation": "Накопитель и цикл for-in."
    },
    {
