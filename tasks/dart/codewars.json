      "prompt": "Верни true, если слово — палиндром (регистр не важен).",
      "starter": "bool isPalindrome(String word) {\n  return false;\n}",
      "tests": [
        {
          "call": "isPalindrome('Шалаш')",
          "expected": "true"
        },
        {
          "call": "isPalindrome('кот')",
          "expected": "false"
        },
        {
          "call": "isPalindrome('а')",
