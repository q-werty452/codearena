    {
      "type": "code",
      "topic": "Формы",
      "difficulty": "medium",
      "timeLimitSec": 420,
      "language": "html",
      "prompt": "Форма регистрации: <fieldset> с заголовком <legend> «Регистрация», обязательное поле email, пароль минимум из 8 символов (minlength) и кнопка отправки.",
      "starter": "<form>\n\n</form>",
      "tests": [],
      "rules": [
        {
          "selector": "fieldset legend",
          "label": "legend «Регистрация»",
          "text": "Регистрация"
        },
        {
          "selector": "input[type=\"email\"][required]",
          "label": "обязательный email"
        },
        {
          "selector": "input[type=\"password\"][minlength=\"8\"]",
          "label": "пароль с minlength=8"
        },
        {
          "selector": "button[type=\"submit\"]",
          "label": "кнопка submit"
        }
      ],
      "solution": "<form>\n  <fieldset>\n    <legend>Регистрация</legend>\n    <input type=\"email\" name=\"email\" required>\n    <input type=\"password\" name=\"password\" minlength=\"8\" required>\n    <button type=\"submit\">Создать</button>\n  </fieldset>\n</form>",
      "explanation": "fieldset и legend группируют поля, required и minlength проверяет сам браузер."
    },
