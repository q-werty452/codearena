      "solution": "<p>Размер:</p>\n<label><input type=\"radio\" name=\"size\" value=\"s\"> S</label>\n<label><input type=\"radio\" name=\"size\" value=\"m\"> M</label>\n<label><input type=\"radio\" name=\"size\" value=\"l\"> L</label>",
