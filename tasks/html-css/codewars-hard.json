    {
      "type": "code",
      "topic": "Flexbox",
      "difficulty": "hard",
      "timeLimitSec": 420,
      "language": "css",
      "prompt": "Шапка .header: flex, логотип слева, меню справа (space-between), всё по центру по вертикали, отступ между пунктами меню .menu — gap 24px (тоже flex).",
      "starter": ".header {\n\n}\n.menu {\n\n}",
      "tests": [],
      "rules": [
        {
          "selector": ".header",
          "css": {
            "property": "display",
            "value": "flex"
          },
          "label": ".header { display: flex }"
        },
        {
          "selector": ".header",
          "css": {
            "property": "justify-content",
            "value": "space-between"
          },
          "label": ".header { justify-content: space-between }"
        },
        {
          "selector": ".header",
          "css": {
            "property": "align-items",
            "value": "center"
          },
          "label": ".header { align-items: center }"
        },
        {
          "selector": ".menu",
          "css": {
            "property": "display",
            "value": "flex"
          },
          "label": ".menu { display: flex }"
        },
        {
          "selector": ".menu",
          "css": {
            "property": "gap",
            "value": "24px"
          },
          "label": ".menu { gap: 24px }"
        }
      ],
      "solution": ".header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.menu {\n  display: flex;\n  gap: 24px;\n}",
      "explanation": "Два flex-контейнера: внешний раскидывает, внутренний — с gap."
    },
