{
  "name": "codearena",
  "displayName": "CodeArena — coding games for class",
  "description": "Kahoot + Codewars inside VS Code: tug of war, quiz, Codewars, race and find-the-bug games for programming lessons.",
  "version": "0.1.0",
  "publisher": "q-werty452",
  "author": {
    "name": "q-werty452",
    "url": "https://github.com/q-werty452"
  },
  "license": "MIT",
  "homepage": "https://github.com/q-werty452/codearena#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-werty452/codearena.git"
  },
  "bugs": {
    "url": "https://github.com/q-werty452/codearena/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1B2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "classroom",
    "education",
    "kahoot",
    "codewars",
    "quiz",
    "game",
    "teacher",
    "school"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codearena",
          "title": "CodeArena",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codearena": [
        {
          "type": "webview",
          "id": "codearena.sidebar",
          "name": "CodeArena"
        }
      ]
    },
    "commands": [
      {
        "command": "codearena.openPanel",
        "title": "Open game panel",
        "category": "CodeArena"
      },
      {
        "command": "codearena.join",
        "title": "Join a room",
        "category": "CodeArena"
      },
      {
        "command": "codearena.createRoom",
        "title": "Create a room (teacher)",
        "category": "CodeArena"
      },
      {
        "command": "codearena.leave",
        "title": "Leave the room",
        "category": "CodeArena"
      },
      {
        "command": "codearena.runTests",
        "title": "Run tests",
        "category": "CodeArena",
        "icon": "$(play)"
      },
      {
        "command": "codearena.submitCode",
        "title": "Submit solution",
        "category": "CodeArena",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codearena.openTaskFile",
        "title": "Open task file",
        "category": "CodeArena"
      },
      {
        "command": "codearena.setStatus",
        "title": "Lesson: set my status",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.done",
        "title": "Lesson: Done",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.writing",
        "title": "Lesson: Still writing",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.lost",
        "title": "Lesson: Lost",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.confused",
        "title": "Lesson: Explain again (anonymous)",
        "category": "CodeArena"
      }
    ],
    "configuration": {
      "title": "CodeArena",
      "properties": {
        "codearena.serverUrl": {
          "type": "string",
          "default": "https://codearena.codearena-server.workers.dev",
          "markdownDescription": "Game server URL. The default is the free public CodeArena server. Change it only if your school runs its own server (see the [README](https://github.com/q-werty452/codearena#self-hosting))."
        }
      }
    },
    "keybindings": [
      {
        "command": "codearena.submitCode",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && codearena.taskFile"
      },
      {
        "command": "codearena.status.done",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.writing",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.lost",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.confused",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "codearena.inLesson"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codearena.runTests",
          "when": "codearena.taskFile",
          "group": "navigation@1"
        },
        {
          "command": "codearena.submitCode",
          "when": "codearena.taskFile",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codearena.runTests",
          "when": "codearena.taskFile"
        },
        {
          "command": "codearena.submitCode",
          "when": "codearena.taskFile"
        },
        {
          "command": "codearena.setStatus",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.done",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.writing",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.lost",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.confused",
          "when": "codearena.inLesson"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && vsce package --no-dependencies",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs codewars && node e2e/run.mjs fixbug && node e2e/run.mjs lesson"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codearena/shared": "*",
    "node-html-parser": "^9.0.7",
    "ws": "^8.21.0"
  }
}
