{
  "name": "codearena",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "q-werty452",
  "author": {
    "name": "q-werty452",
    "url": "https://github.com/q-werty452"
  },
  "license": "MIT",
  "homepage": "https://github.com/q-werty452/codearena#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-werty452/codearena.git"
  },
  "bugs": {
    "url": "https://github.com/q-werty452/codearena/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1B2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "classroom",
    "education",
    "teacher",
    "lesson",
    "kahoot",
    "codewars",
    "quiz",
    "game",
    "school",
    "html",
    "css",
    "javascript",
    "python",
    "урок",
    "учитель"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codearena",
          "title": "CodeArena",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codearena": [
        {
          "type": "webview",
          "id": "codearena.sidebar",
          "name": "CodeArena"
        }
      ]
    },
    "commands": [
      {
        "command": "codearena.openPanel",
        "title": "%command.openPanel%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.join",
        "title": "%command.join%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.createRoom",
        "title": "%command.createRoom%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.leave",
        "title": "%command.leave%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.runTests",
        "title": "%command.runTests%",
        "category": "CodeArena",
        "icon": "$(play)"
      },
      {
        "command": "codearena.submitCode",
        "title": "%command.submitCode%",
        "category": "CodeArena",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codearena.openTaskFile",
        "title": "%command.openTaskFile%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.setStatus",
        "title": "%command.setStatus%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.done",
        "title": "%command.status.done%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.writing",
        "title": "%command.status.writing%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.lost",
        "title": "%command.status.lost%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.status.confused",
        "title": "%command.status.confused%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.paste",
        "title": "%command.paste%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.shareFile",
        "title": "%command.shareFile%",
        "category": "CodeArena",
        "icon": "$(broadcast)"
      },
      {
        "command": "codearena.stopShare",
        "title": "%command.stopShare%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.checkpoint",
        "title": "%command.checkpoint%",
        "category": "CodeArena",
        "icon": "$(milestone)"
      },
      {
        "command": "codearena.openTeacherCode",
        "title": "%command.openTeacherCode%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.toggleFollow",
        "title": "%command.toggleFollow%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.chooseLessonFile",
        "title": "%command.chooseLessonFile%",
        "category": "CodeArena"
      },
      {
        "command": "codearena.importTasks",
        "title": "%command.importTasks%",
        "category": "CodeArena",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codearena.setAiKey",
        "title": "%command.setAiKey%",
        "category": "CodeArena",
        "icon": "$(key)"
      },
      {
        "command": "codearena.clearAiKey",
        "title": "%command.clearAiKey%",
        "category": "CodeArena"
      }
    ],
    "configuration": {
      "title": "CodeArena",
      "properties": {
        "codearena.serverUrl": {
          "type": "string",
          "default": "https://codearena.codearena-server.workers.dev",
          "markdownDescription": "%config.serverUrl%"
        },
        "codearena.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ai.model%"
        },
        "codearena.ai.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ai.endpoint%"
        }
      }
    },
    "keybindings": [
      {
        "command": "codearena.submitCode",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && codearena.taskFile"
      },
      {
        "command": "codearena.status.done",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.writing",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.lost",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.status.confused",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "codearena.inLesson"
      },
      {
        "command": "codearena.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && codearena.pasteGuard && codearena.taskFile"
      },
      {
        "command": "codearena.paste",
        "key": "shift+insert",
        "when": "editorTextFocus && codearena.pasteGuard && codearena.taskFile"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codearena.runTests",
          "when": "codearena.taskFile",
          "group": "navigation@1"
        },
        {
          "command": "codearena.submitCode",
          "when": "codearena.taskFile",
          "group": "navigation@2"
        },
        {
          "command": "codearena.shareFile",
          "when": "codearena.isTeacher && resourceScheme == file",
          "group": "navigation@5"
        },
        {
          "command": "codearena.checkpoint",
          "when": "codearena.isTeacher && resourceScheme == file",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "codearena.runTests",
          "when": "codearena.taskFile"
        },
        {
          "command": "codearena.submitCode",
          "when": "codearena.taskFile"
        },
        {
          "command": "codearena.setStatus",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.done",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.writing",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.lost",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.status.confused",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.paste",
          "when": "false"
        },
        {
          "command": "codearena.shareFile",
          "when": "codearena.isTeacher"
        },
        {
          "command": "codearena.stopShare",
          "when": "codearena.isTeacher"
        },
        {
          "command": "codearena.checkpoint",
          "when": "codearena.isTeacher"
        },
        {
          "command": "codearena.openTeacherCode",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.toggleFollow",
          "when": "codearena.inLesson"
        },
        {
          "command": "codearena.chooseLessonFile",
          "when": "codearena.inLesson"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && vsce package --no-dependencies",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs codewars && node e2e/run.mjs fixbug && node e2e/run.mjs lesson && node e2e/run.mjs anticheat && node e2e/run.mjs livestudent && node e2e/run.mjs liveteacher && node e2e/run.mjs mytasks && node e2e/run.mjs teacherui"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codearena/shared": "*",
    "node-html-parser": "^9.0.7",
    "ws": "^8.21.0"
  },
  "preview": true,
  "pricing": "Free"
}
